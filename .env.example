# ArtistAssist environment template — copy to .env and fill in.
# Never commit real secrets.

# App
APP_NAME=ArtistAssist
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/artistassist.db
MEDIA_ROOT=./storage
TOKEN_ENCRYPTION_KEY=change-me-to-a-32-byte-url-safe-base64-key

# LLM (content agent chat). openai | anthropic (Claude)
LLM_PROVIDER=openai
# Content Studio chat. 1 = live OpenAI/Anthropic; 0 = deterministic mock (OPENAI_LIVE still accepted)
LLM_LIVE=0

# OpenAI (chat when LLM_PROVIDER=openai; optional image generate/edit)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Anthropic / Claude (chat when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6

# Platform sync (Spotify, Meta, TikTok, YouTube, etc.). 1 = live APIs; 0 = recorded fixtures
PLATFORM_LIVE=0

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8080/api/oauth/spotify/callback

# SoundCloud
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=http://localhost:8080/api/oauth/soundcloud/callback

# Deezer
DEEZER_APP_ID=
DEEZER_APP_SECRET=
DEEZER_REDIRECT_URI=http://localhost:8080/api/oauth/deezer/callback

# Meta (Instagram / Facebook / Threads)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8080/api/oauth/meta/callback
# Live sync bootstrap (filled by `make meta-connect` or manually)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/api/oauth/tiktok/callback

# YouTube (Google)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/oauth/youtube/callback

# Optional Cloudflare R2 (default: local disk)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Sync
SYNC_CRON_HOUR=3
SYNC_CRON_MINUTE=0

# Frontend (build-time; API is same-origin via Caddy)
VITE_APP_NAME=ArtistAssist
